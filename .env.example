NODE_ENV=development
PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
# URL-encode special characters in passwords. Match MYSQL_PASSWORD below.
DATABASE_URL=mysql://digituck:replace-with-local-db-password@127.0.0.1:3307/digituck
MYSQL_DATABASE=digituck
MYSQL_USER=digituck
MYSQL_PASSWORD=replace-with-local-db-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PORT=3307
MYSQL_TEST_PASSWORD=replace-with-test-password
# Strictly opt-in; production always refuses demo seeds.
ALLOW_DEMO_SEED=false
# Generate a random secret before starting the API.
SESSION_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY_HOPS=0
PENDING_TIMEOUT_MINUTES=15
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
DOCUMENT_TYPES=business-proof
STORAGE_DRIVER=local
STORAGE_DIRECTORY=.local-storage/private-documents
# Production requires a private S3-compatible bucket; no public ACL or URL.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# AWS credentials use the standard SDK environment/role credential provider.
# Must be a separate, disposable database whose name ends in _test.
TEST_DATABASE_URL=mysql://digituck_test:replace-with-test-password@127.0.0.1:3308/digituck_test
ALLOW_DB_TEST_RESET=false
# Bootstrap credentials are supplied temporarily by the operator, not committed:
# ADMIN_FULL_NAME=
# ADMIN_EMAIL=
# ADMIN_PHONE=
# ADMIN_PASSWORD=

