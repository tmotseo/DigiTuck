          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 20,
              "maximum": 100
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "digituck.sid",
        "description": "Production cookie: __Host-digituck.sid"
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "schemas": {
      "Registration": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "example": "+27821234567"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "description": "Maximum 72 UTF-8 bytes"
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "VENDOR"
            ]
          }
        },
        "required": [
          "fullName",
          "email",
          "phone",
          "password",
          "role"
        ]
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 12
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Account": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "phone": {
            "type": "string"
          }
        },
        "required": [
          "fullName",
          "phone"
        ]
      },
      "PasswordChange": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "description": "Maximum 72 UTF-8 bytes"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "phone": {
            "type": "string",
            "example": "+27821234567"
          },
          "address": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          },
          "area": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "hours": {
            "type": "array",
            "maxItems": 7,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "day": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "open": {
                  "type": "string",
                  "example": "08:00"
                },
                "close": {
                  "type": "string",
                  "example": "17:00"
                }
              },
              "required": [
                "day",
                "open",
                "close"
              ]
            }
          },
          "isPaused": {
            "type": "boolean"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "description",
          "phone",
          "address",
          "area",
          "hours",
          "isPaused",
          "expectedVersion"
        ]
      },
      "Version": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "expectedVersion"
        ]
      },
      "Upload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document": {
            "type": "string",
            "format": "binary",
            "description": "PDF/JPEG/PNG, validated signature and MIME, max 10485760 bytes"
          },
          "type": {
            "type": "string"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "document",
          "type",
          "expectedVersion"
        ]
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "submissionVersion": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT",
              "SUSPEND"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          }
        },
        "required": [
          "expectedVersion",
          "submissionVersion",
          "action",
          "reason"
        ]
      },
      "UserStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          }
        },
        "required": [
          "status",
          "reason"
        ]
      }
    }
  }
}
