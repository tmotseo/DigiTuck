      "patch": {
        "summary": "Activate/deactivate account and revoke sessions",
        "security": [
          {
            "session": [],
            "csrf": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful data envelope"
          },
          "401": {
            "description": "Session missing, expired or revoked"
          },
          "403": {
            "description": "Wrong role or invalid CSRF/Origin"
          },
          "404": {
            "description": "Unknown or inaccessible resource"
          },
          "409": {
            "description": "Stale version, state or duplicate conflict"
          },
          "422": {
            "description": "Validation or file rejection"
          },
          "429": {
            "description": "Persistent authentication throttling"
          },
          "500": {
            "description": "Redacted unexpected failure"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "http://127.0.0.1:5173"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserStatus"
              }
            }
          }
        }
      }
    },
    "/admin/audit": {
      "get": {
        "summary": "Read append-only audit",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful data envelope"
          },
          "401": {
            "description": "Session missing, expired or revoked"
          },
          "403": {
            "description": "Wrong role or invalid CSRF/Origin"
          },
          "404": {
            "description": "Unknown or inaccessible resource"
          },
          "409": {
            "description": "Stale version, state or duplicate conflict"
          },
          "422": {
            "description": "Validation or file rejection"
          },
          "429": {
            "description": "Persistent authentication throttling"
          },
          "500": {
            "description": "Redacted unexpected failure"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
